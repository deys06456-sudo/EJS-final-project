
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Category</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">

    <h2 class="mb-4">Category Details</h2>

    <div class="card">
        <div class="card-body">
            <h4><%= category.name %></h4>
            <hr>

            <p><strong>Category ID:</strong> <%= category._id %></p>
            <p><strong>Name:</strong> <%= category.name %></p>
            <p><strong>Description:</strong> <%= category.description %></p>
            <p><strong>Status:</strong> <%= category.status %></p>
            <p><strong>Created At:</strong>
                <%= category.createdAt ? new Date(category.createdAt).toLocaleString() : 'N/A' %>
            </p>
            <p><strong>Updated At:</strong>
                <%= category.updatedAt ? new Date(category.updatedAt).toLocaleString() : 'N/A' %>
            </p>

            <a href="/categories" class="btn btn-secondary">Back</a>
            <a href="/categories/edit/<%= category._id %>" class="btn btn-warning">Edit Category</a>
        </div>
    </div>

</div>
</body>
</html>
