
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Brand</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">

    <h2 class="mb-4">Brand Details</h2>

    <div class="card">
        <div class="card-body">
            <h4><%= brand.name %></h4>
            <hr>

            <p><strong>Brand ID:</strong> <%= brand._id %></p>
            <p><strong>Name:</strong> <%= brand.name %></p>
            <p><strong>Description:</strong> <%= brand.description %></p>
            <p><strong>Status:</strong> <%= brand.status %></p>
            <p><strong>Created At:</strong>
                <%= brand.createdAt ? new Date(brand.createdAt).toLocaleString() : 'N/A' %>
            </p>
            <p><strong>Updated At:</strong>
                <%= brand.updatedAt ? new Date(brand.updatedAt).toLocaleString() : 'N/A' %>
            </p>

            <a href="/brands" class="btn btn-secondary">Back</a>
            <a href="/brands/edit/<%= brand._id %>" class="btn btn-warning">Edit Brand</a>
        </div>
    </div>

</div>
</body>
</html>
